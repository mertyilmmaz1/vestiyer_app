# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
doc/api/

# dotenv environment variables file (gizli anahtarlar – asla commit etmeyin)
.env
.env*
!.env.example
.env.local
.env.*.local

# Firebase – proje bazlı config (API anahtarları içerir)
**/GoogleService-Info.plist
**/google-services.json
# Firebase Admin SDK (service account key) – asla commit etmeyin
*-firebase-adminsdk-*.json
serviceAccount*.json
**/serviceAccount*.json

# Cursor IDE
.cursor/

# Yerel / örnek dosyalar (GitHub’a gönderilmesin)
ornek_*.dart
ornek_*.md

# macOS
.DS_Store

# IDE
.idea/
*.iml
.vscode/
!*.code-workspace

# Android – yerel ayarlar, imza anahtarları ve derleme önbelleği
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/*.keystore
**/android/*.jks
*.keystore
*.jks
**/android/**/GeneratedPluginRegistrant.java
**/android/captures/

# iOS – CocoaPods ve kullanıcı verisi
**/ios/Pods/
**/ios/**/xcuserdata/
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec

# Coverage / test çıktıları
coverage/

# Avoid committing generated Javascript files:
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Node (Firebase Functions) – bağımlılıklar yerel kurulur
functions/node_modules/

# VPS / deploy – şifre ve URL’ler .env’de tutulur
# deploy_vps.sh script’i .env’den okur; .env commit edilmez
