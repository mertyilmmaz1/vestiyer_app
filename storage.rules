rules_version = '2';
// Storage: kıyafet görselleri ve profil fotoğrafları; kullanıcı sadece kendi klasörüne yazabilir.
service firebase.storage {
  match /b/{bucket}/o {
    match /clothing_images/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /profile_images/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
