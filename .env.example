# Copy this file to .env and fill in your values.
# Required for Firebase (lib/firebase_options.dart).

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=
# Optional for Android
FIREBASE_ANDROID_CLIENT_ID=

# RevenueCat (subscriptions). Use one key for both platforms (e.g. testing) or separate keys.
# Single key (optional): used on both iOS and Android when set.
REVENUECAT_API_KEY=
# Or platform-specific (production):
# REVENUECAT_APPLE_API_KEY=
# REVENUECAT_GOOGLE_API_KEY=

# iOS TestFlight'ta profile ekranında test premium butonunu gösterir (true/false)
SHOW_TEST_PREMIUM_BUTTON=false
