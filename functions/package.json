{
  "name": "dolap-ai-functions",
  "description": "Firebase Cloud Functions for Dolap AI - Auth, Firestore, OpenAI, Storage (profile/clothing images)",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "check-vps-health": "node scripts/check-vps-health.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.9.0",
    "openai": "^4.77.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.3.0"
  },
  "private": true
}
